{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TrentBest/TheSingularityWorkshop.CiAi/development/schemas/ciai.workflow-evidence.v2.schema.json",
  "title": "CiAi authoritative workflow evidence v2",
  "description": "Exact-run workflow evidence with separately validated provenance and explicit host-registered required-check observations. Workflow trust is not serialized and must be re-evaluated by the receiving host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schema",
    "workflowEvidence",
    "requiredChecks"
  ],
  "properties": {
    "contractVersion": {
      "const": 2
    },
    "schema": {
      "const": "ciai.workflow-evidence.v2"
    },
    "workflowEvidence": {
      "type": "object",
      "required": [
        "contractVersion",
        "schema",
        "observedRun",
        "provenance"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "schema": {
          "const": "ciai.workflow-evidence.v1"
        },
        "observedRun": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "jobName",
          "state",
          "jobId",
          "status",
          "conclusion",
          "evidenceUrl",
          "startedAt",
          "completedAt"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "jobName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "state": {
            "enum": [
              "observed",
              "missing",
              "ambiguous"
            ]
          },
          "jobId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "conclusion": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "success",
              "failure",
              "cancelled",
              "timed_out",
              "action_required",
              "neutral",
              "skipped",
              "stale",
              "startup_failure",
              null
            ]
          },
          "evidenceUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  }
}
