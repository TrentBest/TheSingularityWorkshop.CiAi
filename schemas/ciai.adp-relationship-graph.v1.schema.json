{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TrentBest/TheSingularityWorkshop.CiAi/development/schemas/ciai.adp-relationship-graph.v1.schema.json",
  "title": "CiAi ADP relationship graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "relationships"
  ],
  "properties": {
    "schema": {
      "const": "ciai.adp-relationship-graph.v1"
    },
    "version": {
      "const": 1
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relationshipId",
          "contractVersion",
          "kind",
          "sourceRepository",
          "targetRepository",
          "artifactKind",
          "authorityRepository"
        ],
        "properties": {
          "relationshipId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "contractVersion": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "ContentContribution",
              "CanonicalContentConsumption",
              "ExperienceValidation",
              "BuildDependency"
            ]
          },
          "sourceRepository": {
            "$ref": "#/$defs/repository"
          },
          "targetRepository": {
            "$ref": "#/$defs/repository"
          },
          "artifactKind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "authorityRepository": {
            "$ref": "#/$defs/repository"
          }
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
    }
  }
}
