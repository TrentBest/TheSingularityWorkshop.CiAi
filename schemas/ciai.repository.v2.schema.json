{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TrentBest/TheSingularityWorkshop.CiAi/development/schemas/ciai.repository.v2.schema.json",
  "title": "CiAi repository manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "badges",
    "dependencies",
    "extensions",
    "relationships"
  ],
  "properties": {
    "schema": {
      "const": "ciai.repository.v2"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "observerProfile": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 80
    },
    "badges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/badge"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "adp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/adp"
        }
      ]
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "workflowFile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "workflowFile": {
          "type": "string",
          "pattern": "^[^/]+\\.ya?ml$"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "capability": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipId",
        "contractVersion",
        "kind",
        "sourceRepository",
        "targetRepository",
        "artifactKind",
        "authorityRepository"
      ],
      "properties": {
        "relationshipId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "ContentContribution",
            "CanonicalContentConsumption",
            "ExperienceValidation",
            "BuildDependency"
          ]
        },
        "sourceRepository": {
          "$ref": "#/$defs/repository"
        },
        "targetRepository": {
          "$ref": "#/$defs/repository"
        },
        "artifactKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "authorityRepository": {
          "$ref": "#/$defs/repository"
        }
      }
    },
    "adp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumRepairAttempts",
        "requireHumanApprovalForWrites"
      ],
      "properties": {
        "maximumRepairAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "requireHumanApprovalForWrites": {
          "type": "boolean"
        }
      }
    }
  }
}
